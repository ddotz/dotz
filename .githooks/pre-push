#!/bin/sh
# Refuses a push whose branch tips break the repo-wide limits (hub/engineering-rules.test.ts). It checks the pushed commit, not the working tree, so
# an uncommitted change neither hides nor causes a failure. core.hooksPath points here: set by hub/git-hooks.ts, never by hand.
export PATH="$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v bun >/dev/null 2>&1 || { echo "pre-push: bun not found, cannot run hub/engineering-rules.test.ts" >&2; exit 1; }
tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
seen=""
guard=$(dirname "$0")/../hub/history-rewrite.ts
while read -r _ sha ref _; do
	case "$sha" in *[!0]*) ;; *) continue ;; esac # all zeros: a ref being deleted
	if [ -f "$guard" ]; then bun "$guard" --guard "$1" "$sha" </dev/null || exit 1; fi # rewritten-away history never goes back up, on any ref
	case "$ref" in refs/heads/*) ;; *) continue ;; esac # a tag names a commit already checked on its branch
	case " $seen " in *" $sha "*) continue ;; esac
	seen="$seen $sha"
	rm -rf "$tmp/tree" && mkdir "$tmp/tree"
	git archive "$sha" | tar -x -C "$tmp/tree" || exit 1
	if ! (cd "$tmp/tree" && bun test hub/engineering-rules.test.ts) >"$tmp/out" 2>&1; then
		grep -E '^\+ +"|\(fail\)' "$tmp/out" >&2 || tail -n 30 "$tmp/out" >&2
		echo "pre-push: refused, $ref at $sha is over a limit. Shrink the code; never raise a ceiling (docs/engineering-standards.md)." >&2
		exit 1
	fi
done
